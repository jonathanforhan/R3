#version 460
#extension GL_EXT_mesh_shader : require

#define MAX_VERTICES 36  // Cube has 36 vertices (6 faces * 2 triangles * 3 vertices)
#define MAX_PRIMITIVES 12 // Cube has 12 triangles (6 faces * 2 triangles)

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_VERTICES, max_primitives = MAX_PRIMITIVES) out;

layout(location = 0) out vec3 v_TexCoords[MAX_VERTICES];

layout(binding = 32) uniform ModelViewProjection {
    mat4 u_View;
    mat4 u_Proj;
};

// Cube vertices (positions that will be used as texture coordinates)
const vec3 cubeVertices[36] = vec3[36](
    // Front face
    vec3(-1.0, -1.0,  1.0), vec3( 1.0, -1.0,  1.0), vec3( 1.0,  1.0,  1.0),
    vec3( 1.0,  1.0,  1.0), vec3(-1.0,  1.0,  1.0), vec3(-1.0, -1.0,  1.0),
    
    // Back face
    vec3(-1.0, -1.0, -1.0), vec3(-1.0,  1.0, -1.0), vec3( 1.0,  1.0, -1.0),
    vec3( 1.0,  1.0, -1.0), vec3( 1.0, -1.0, -1.0), vec3(-1.0, -1.0, -1.0),
    
    // Top face
    vec3(-1.0,  1.0, -1.0), vec3(-1.0,  1.0,  1.0), vec3( 1.0,  1.0,  1.0),
    vec3( 1.0,  1.0,  1.0), vec3( 1.0,  1.0, -1.0), vec3(-1.0,  1.0, -1.0),
    
    // Bottom face
    vec3(-1.0, -1.0, -1.0), vec3( 1.0, -1.0, -1.0), vec3( 1.0, -1.0,  1.0),
    vec3( 1.0, -1.0,  1.0), vec3(-1.0, -1.0,  1.0), vec3(-1.0, -1.0, -1.0),
    
    // Right face
    vec3( 1.0, -1.0, -1.0), vec3( 1.0,  1.0, -1.0), vec3( 1.0,  1.0,  1.0),
    vec3( 1.0,  1.0,  1.0), vec3( 1.0, -1.0,  1.0), vec3( 1.0, -1.0, -1.0),
    
    // Left face
    vec3(-1.0, -1.0, -1.0), vec3(-1.0, -1.0,  1.0), vec3(-1.0,  1.0,  1.0),
    vec3(-1.0,  1.0,  1.0), vec3(-1.0,  1.0, -1.0), vec3(-1.0, -1.0, -1.0)
);

void main() {
    uint tid = gl_LocalInvocationID.x;
    
    SetMeshOutputsEXT(MAX_VERTICES, MAX_PRIMITIVES);
    
    // Process vertices
    if (tid < MAX_VERTICES) {
        vec3 a_Position = cubeVertices[tid];
        
        v_TexCoords[tid] = a_Position;  // Use position as texture coordinates
        gl_MeshVerticesEXT[tid].gl_Position = u_Proj * mat4(mat3(u_View)) * vec4(a_Position, 1.0);
    }
    
    // Process primitives (triangles)
    if (tid < MAX_PRIMITIVES) {
        uint baseIndex = tid * 3;
        gl_PrimitiveTriangleIndicesEXT[tid] = uvec3(
            baseIndex + 0,
            baseIndex + 1,
            baseIndex + 2
        );
    }
}