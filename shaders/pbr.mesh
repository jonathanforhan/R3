#version 460
#extension GL_EXT_mesh_shader : require

#define MAX_JOINT_INFLUENCE 4
#define MAX_VERTICES 64
#define MAX_PRIMITIVES 21

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_VERTICES, max_primitives = MAX_PRIMITIVES) out;

layout(location = 0) out vec3 v_Position[MAX_VERTICES];
layout(location = 1) out vec3 v_Normal[MAX_VERTICES];
layout(location = 2) out vec2 v_TexCoords[MAX_VERTICES];

// Uniforms
layout(binding = 32) uniform ModelViewProjection {
    mat4 u_View;
    mat4 u_Proj;
};

// SSBOs
layout(binding = 0) readonly buffer Positions  { vec3 s_Positions[]; };
layout(binding = 1) readonly buffer Normals    { vec3 s_Normals[]; };
layout(binding = 2) readonly buffer Tangents   { vec3 s_Tangents[]; };
layout(binding = 3) readonly buffer Bitangents { vec3 s_Bitangents[]; };
layout(binding = 4) readonly buffer TexCoords  { vec2 s_TexCoords[]; };
layout(binding = 5) readonly buffer JointIDs   { ivec4 s_JointIDs[]; };
layout(binding = 6) readonly buffer Weights    { vec4 s_Weights[]; };
layout(binding = 7) readonly buffer Indices    { uint s_Indices[]; };
layout(binding = 8) readonly buffer JointTransforms { mat4 s_JointTransforms[]; };

// Push Constants
layout(push_constant) uniform MeshPushConstants {
    mat4 c_Model;
    uint c_MeshletOffset;   // Which meshlet to render
    uint c_VertexCount;     // Vertices in this meshlet
    uint c_PrimitiveCount;  // Triangles in this meshlet
};

void main() {
    uint tid = gl_LocalInvocationID.x;
    
    SetMeshOutputsEXT(c_VertexCount, c_PrimitiveCount);
    
    if (tid < c_VertexCount) {
        uint vertexIndex = c_MeshletOffset + tid;
        
        // Fetch vertex data
        vec3 a_Position  = s_Positions[vertexIndex];
        vec3 a_Normal    = s_Normals[vertexIndex];
        vec2 a_TexCoords = s_TexCoords[vertexIndex];
        ivec4 a_JointIDs = s_JointIDs[vertexIndex];
        vec4 a_Weights   = s_Weights[vertexIndex];
        
        // Apply skeletal animation
        /*
        mat4 skinMatrix = mat4(0.0);
        for(int i = 0; i < MAX_JOINT_INFLUENCE; ++i) {
            if(a_JointIDs[i] == -1) continue;
            if(a_JointIDs[i] >= s_JointTransforms.length()) continue;
            skinMatrix += a_Weights[i] * s_JointTransforms[a_JointIDs[i]];
        }
        
        vec4 skinnedPosition = skinMatrix * vec4(a_Position, 1.0);
        vec3 skinnedNormal = mat3(skinMatrix) * a_Normal;
        
        v_Position[tid] = vec3(c_Model * skinnedPosition);
        v_Normal[tid] = mat3(transpose(inverse(c_Model))) * skinnedNormal;
        v_TexCoords[tid] = a_TexCoords;

        gl_MeshVerticesEXT[tid].gl_Position = u_Proj * u_View * vec4(v_Position[tid], 1.0);
        */

        v_Position[tid] = vec3(c_Model * vec4(a_Position, 1.0));
        v_Normal[tid] = mat3(transpose(inverse(c_Model))) * a_Normal;
        v_TexCoords[tid] = a_TexCoords;

        gl_MeshVerticesEXT[tid].gl_Position = u_Proj * u_View * vec4(v_Position[tid], 1.0);
    }
    
    if (tid < c_PrimitiveCount) {
        uint baseIndex = tid * 3;
        gl_PrimitiveTriangleIndicesEXT[tid] = uvec3(
            s_Indices[baseIndex + 0],
            s_Indices[baseIndex + 1], 
            s_Indices[baseIndex + 2]
        );
    }
}