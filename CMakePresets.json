{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-base",
      "hidden": true,
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-x86-base",
      "hidden": true,
      "inherits": "windows-base",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "sourceDir": "$env{HOME}/.vs/$ms{projectDirName}"
        }
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "vulkan-base",
      "hidden": true,
      "cacheVariables": {
        "R3_VULKAN": true
      }
    },
    {
      "name": "opengl-base",
      "hidden": true,
      "cacheVariables": {
        "R3_OPENGL": true
      }
    },
    {
      "name": "dx12-base",
      "hidden": true,
      "cacheVariables": {
        "R3_DX12": true
      }
    },
    {
      "name": "vulkan-x64-debug",
      "displayName": "Vulkan x64 Debug",
      "inherits": [ "windows-x64-base", "debug-base", "vulkan-base" ]
    },
    {
      "name": "vulkan-x64-release",
      "displayName": "Vulkan x64 Release",
      "inherits": [ "windows-x64-base", "release-base", "vulkan-base" ]
    },
    {
      "name": "opengl-x64-debug",
      "displayName": "OpenGL x64 Debug",
      "hidden": true,
      "inherits": [ "windows-x64-base", "debug-base", "opengl-base" ]
    },
    {
      "name": "opengl-x64-release",
      "displayName": "OpenGL x64 Release",
      "hidden": true,
      "inherits": [ "windows-x64-base", "release-base", "opengl-base" ]
    },
    {
      "name": "dx12-x64-debug",
      "displayName": "DirectX12 x64 Debug",
      "hidden": true,
      "inherits": [ "windows-x64-base", "debug-base", "dx12-base" ]
    },
    {
      "name": "dx12-x64-release",
      "displayName": "DirectX12 x64 Release",
      "hidden": true,
      "inherits": [ "windows-x64-base", "release-base", "dx12-base" ]
    }
  ]
}
